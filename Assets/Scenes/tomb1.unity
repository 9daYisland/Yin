  m_Script: {fileID: 11500000, guid: acd42753791b9cc4f8e3c4967f8a0132, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PickupInfoUI
  infoPanel: {fileID: 1316091608}
  infoText: {fileID: 1111318575}
  fullText: 'Crack-making on the day Jiashen. Diviner Que asked:

    Will Fu Hao
    have a fortunate delivery?


    The king read the crack and said:

    If she
    gives birth on the day Ding, it will be fortunate. If she gives birth on the
    day Geng, it will be greatly auspicious.

    Thirty-one days later, on the day
    Jiayin, she gave birth. It was not fortunate. It was a girl.'
  secondsPerCharacter: 0.05
