  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PickupInfoUI
  infoPanel: {fileID: 1200793729}
  infoText: {fileID: 1276001469}
  fullText: 'Crack-making on the day Xinwei. Diviner Zheng asked:

    Should Fu
    Hao join Zhi Jia in attacking the Ba? Should the king personally attack from
    the east?

    Should Fu Hao join Zhi Jia in attacking the Ba? Should the king
    refrain from attacking from the east?

    Should the king order Fu Hao to lead
    Marquis Gao in attacking the Yi?

    Should the king not order Fu Hao to lead
    Marquis Gao in attacking the Yi?

    (Ba and Yi were neighboring polities or
    tribal groups frequently mentioned in Shang oracle bones.)'
  secondsPerCharacter: 0.05
