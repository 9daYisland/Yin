  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'I hear today''s divination concerns Fu Hao. If the ancestors show a favorable
    sign, she may enter the temple to preside over the rites.


    Fu Hao is of
    royal blood, and she has both conducted sacrifices by royal command and led armies
    into battle. If even she cannot bear this duty, who else could?



    Watch
    your words. The right to preside over sacrifice does not rest on what men say,
    but on the oracle''s verdict. Until the ancestors'' will is revealed, no one
    may presume to judge.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
