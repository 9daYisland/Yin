  m_Script: {fileID: 11500000, guid: e04a9b6260e906b4d96bad39b8437c22, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TitleDialoguePlayer
  titleText: {fileID: 0}
  titleGroup: {fileID: 0}
  titleContent: "Circa 1200 BCE, Yin-Shang Dynasty, the royal ancestral temple \u2014
    a divination concerning the right to preside over sacrificial rites is about
    to begin."
  titleFadeInDuration: 1
  titleHoldDuration: 3
  titleFadeOutDuration: 1
  subtitle1Text: {fileID: 0}
  subtitle1Group: {fileID: 0}
  subtitle1: "The great state sacrifice draws near \u2014 who is worthy to preside
    over it?\r\n\r\nThis is not a matter for private discussion among men. To offer
    sacrifice to the ancestors, one must first seek divination. If the ancestors
    do not consent, no one may proceed.\r\n"
  subtitle2Text: {fileID: 0}
  subtitle2Group: {fileID: 0}
  subtitle2: 
  audioSource1: {fileID: 465635781}
  audioClip1: {fileID: 8300000, guid: 3f532a700e3d71f4796f7079313f87f9, type: 3}
  audioSource2: {fileID: 0}
  audioClip2: {fileID: 0}
  delayBeforeClip3: 1.5
  subtitle3Text: {fileID: 0}
  subtitle3Group: {fileID: 0}
  subtitle3: "Silence \u2014 the diviner approaches.\r\n\r\nFu Hao has arrived as
    well."
  audioSource3: {fileID: 1876547130}
  audioClip3: {fileID: 8300000, guid: c1a5cbf51ac53d448a212f4fbffbb4a8, type: 3}
